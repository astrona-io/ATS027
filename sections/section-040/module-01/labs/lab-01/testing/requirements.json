{
  "context": "kind-astro-ats-027-lab-040-01-01",
  "resources": [
    {
      "kind": "persistentvolumeclaim",
      "name": "probe-data",
      "expected": {
        "apiVersion": "v1",
        "kind": "PersistentVolumeClaim",
        "metadata": {
          "name": "probe-data",
          "namespace": "starfleet"
        },
        "spec": {
          "accessModes": [
            "ReadWriteOnce"
          ],
          "resources": {
            "requests": {
              "storage": "128Mi"
            }
          }
        }
      },
      "state": "pvc"
    },
    {
      "kind": "pod",
      "name": "volume-reader",
      "expected": {
        "apiVersion": "v1",
        "kind": "Pod",
        "metadata": {
          "name": "volume-reader",
          "namespace": "starfleet"
        },
        "spec": {
          "restartPolicy": "Never",
          "containers": [
            {
              "name": "reader",
              "image": "docker.io/library/busybox:1.37.0",
              "command": [
                "sh",
                "-c",
                "sleep 3600"
              ],
              "volumeMounts": [
                {
                  "name": "data",
                  "mountPath": "/data"
                },
                {
                  "name": "scratch",
                  "mountPath": "/scratch"
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "data",
              "persistentVolumeClaim": {
                "claimName": "probe-data"
              }
            },
            {
              "name": "scratch",
              "emptyDir": {}
            }
          ]
        }
      },
      "state": "pod"
    }
  ],
  "behavior": [
    {
      "args": [
        "kubectl",
        "-n",
        "starfleet",
        "exec",
        "volume-reader",
        "--",
        "sh",
        "-c",
        "cat /data/marker; test ! -e /scratch/marker"
      ],
      "equals": "persistent"
    }
  ]
}
